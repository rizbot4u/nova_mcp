# Copy this file to .env and fill in real values.
# The real .env is gitignored and must never be committed.

# Shared secret with Jarvis — must match on both sides.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_SECRET=replace_with_64_char_hex

# Bybit V5 API credentials
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=true
BROKER_CODE=Kr000820

# Base Mainnet RPC (Alchemy, Infura, etc.)
EVM_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_key

# DKHYR token contract on Base
DKHYR_TOKEN_ADDRESS=0x9991bE994829601F90328CCF9cee4D1A55ADae70

# Treasury wallet private key — required only for on-chain writes
TREASURY_PRIVATE_KEY=0xyour_private_key_here

# Server
PORT=8001
